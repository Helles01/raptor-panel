# The environment of the panel: copy it to /etc/raptor/raptor.env, fill in what is empty, and keep it where only root can read it
#     install -m 0600 -o root -g root deploy/raptor.env.example /etc/raptor/raptor.env
# systemd reads it before it starts the panel as its own user, so the panel's user does not need to read the file.
#
# A line that starts with # shows a variable at its default, or an example. Secrets are empty here on purpose: make them, do not copy them from anywhere.
# `raptor doctor` looks at all of it before the panel is started.

# --- the address and where to listen ---------------------------------------------------------------------------------------------------
# The public address of the panel, as the browser sees it: https://panel.example.com (no path). It is also what the nodes are told to call.
RAPTOR_APP_URL=https://panel.example.com
# Where the panel listens. Behind a reverse proxy this stays on the machine itself.
RAPTOR_HTTP_LISTEN=127.0.0.1:8080
# The reverse proxies whose X-Forwarded-For is believed, comma separated addresses or ranges. Without it every client looks like the proxy.
RAPTOR_TRUSTED_PROXIES=127.0.0.1
# The time zone of the schedules; UTC is recommended.
# RAPTOR_APP_TIMEZONE=UTC
# The folder with the build of the frontend (manifest.json and the files it names).
# RAPTOR_ASSETS_DIR=/opt/raptor/web/public/assets

# --- the database ---------------------------------------------------------------------------------------------------------------------
RAPTOR_DB_HOST=127.0.0.1
# RAPTOR_DB_PORT=3306
RAPTOR_DB_NAME=raptor
RAPTOR_DB_USER=raptor
# Make a new password for this user; do not reuse one from the old panel.
RAPTOR_DB_PASSWORD=
# false, true, skip-verify or preferred
# RAPTOR_DB_TLS=false
# The same, for the hosts the databases of servers are made on.
# RAPTOR_DB_HOSTS_TLS=false

# --- secrets --------------------------------------------------------------------------------------------------------------------------
# The key of Raptor's own secret format: `raptor keygen` makes one. Keep a copy somewhere safe and apart from the database: without it the secrets stored with it
# cannot be read again. It is not the APP_KEY of the old panel and must not be made from it.
RAPTOR_SECRET_KEY=
# Only while `raptor migrate-secrets` runs, and only on that command's own line (never in this file): RAPTOR_LEGACY_APP_KEY, the APP_KEY of the old panel.

# --- the nodes ------------------------------------------------------------------------------------------------------------------------
# For a test machine only: do not check the certificates of the nodes.
# RAPTOR_WINGS_INSECURE_TLS=false

# --- backups on S3 (leave all of it out to keep backups on the nodes) -----------------------------------------------------------------
# Where new backups go: wings (the node) or s3. Backups that exist stay where they are, so this can be changed later.
# RAPTOR_BACKUPS_DRIVER=wings
# The address of an S3-compatible server; leave it out for Amazon S3.
# RAPTOR_BACKUPS_S3_ENDPOINT=https://minio.example.com:9000
# RAPTOR_BACKUPS_S3_REGION=eu-central-1
# RAPTOR_BACKUPS_S3_BUCKET=raptor-backups
# RAPTOR_BACKUPS_S3_ACCESS_KEY=
# RAPTOR_BACKUPS_S3_SECRET_KEY=
# true puts the bucket in the path of the address (most S3-compatible servers want it).
# RAPTOR_BACKUPS_S3_PATH_STYLE=false
# RAPTOR_BACKUPS_S3_STORAGE_CLASS=STANDARD_IA
# How long the addresses the nodes upload the parts to are good for, in minutes (1 to 10080), and the size of one part in bytes (5 MiB to 5 GiB).
# RAPTOR_BACKUPS_PRESIGNED_MINUTES=60
# RAPTOR_BACKUPS_MAX_PART_SIZE=5368709120

# --- what the panel offers (the defaults are the reference's) -------------------------------------------------------------------------
# RAPTOR_FEATURES_DATABASES=true
# RAPTOR_FEATURES_DATABASES_RANDOM_HOST=true
# RAPTOR_FEATURES_HIDE_ADMIN_ACTIVITY=false
# RAPTOR_FEATURES_BACKUP_THROTTLE_LIMIT=2
# RAPTOR_FEATURES_BACKUP_THROTTLE_SECONDS=600
# RAPTOR_FEATURES_NOTIFY_INSTALL=true
# RAPTOR_FEATURES_NOTIFY_REINSTALL=true

# --- the log and development ----------------------------------------------------------------------------------------------------------
# debug, info, warn or error; text or json
# RAPTOR_LOG_LEVEL=info
# RAPTOR_LOG_FORMAT=json
# For development: serve a new build of the frontend without a restart.
# RAPTOR_WEB_RELOAD=false

# A file with the same settings (YAML); what is in the environment wins over what is in the file.
# RAPTOR_CONFIG=/etc/raptor/raptor.yml
